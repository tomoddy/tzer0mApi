{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Authentication": {
    "PrivatePaths": [
      "/ting/*",
      "/weather/uv/notify",
      "/smartermeter/*",
      "/stockwise/*",
      "/chitter/*"
    ]
  },
  "Weather": {
    "OpenUV": {
      "BaseUrl": "https://api.openuv.io/api/v1/forecast"
    }
  },
  "SmarterMeter": {
    "CaptureIntervalHours": 1,
    "Gemini": {
      "MaxAttempts": 4,
      "BaseBackoffSeconds": 5
    }
  },
  "Chitter": {
    "Printer": {
      "FeedBefore": 0,
      "FeedAfter": 4
    },
    "Image": {
      "WidthPx": 512,
      "FontPath": "Assets/Fonts/SpaceGrotesk-Medium.ttf",
      "BodyFontSize": 28,
      "FooterFontSize": 18,
      "MarginPx": 12,
      "MaxBandHeightPx": 48,
      "BandDelayMs": 700
    }
  }
}